+.item .text.none { color: var(--muted); font-style: italic; font-weight: 400; }
+.item .when { grid-column: 1; color: var(--muted); font-size: 13px; margin: 0; }
+.item button { grid-column: 2; grid-row: 1 / span 2; min-height: 32px; }
